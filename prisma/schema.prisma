generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Church {
  id              String                 @id
  name            String
  location        String
  monthlyGoal     Float
  openingBalance  Float
  version         Int                    @default(0)
  transactions    FinancialTransaction[]
  assets          ChurchAsset[]
  events          ChurchEvent[]
  people          ChurchPerson[]
  commitments     ChurchCommitment[]
  users            User[]
  budgetCategories BudgetCategory[]
  cells            Cell[]
  updatedAt       DateTime               @updatedAt
}

model User {
  id                 String    @id
  churchId           String
  name               String
  email              String    @unique
  phone              String    @default("")
  role               String
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  lastLoginAt        DateTime?
  church             Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId])
}

model BudgetCategory {
  id        String        @id
  churchId  String
  name      String
  type      String
  church    Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  lines     BudgetLine[]

  @@unique([churchId, name])
}

model BudgetLine {
  id             String         @id
  categoryId     String
  year           Int
  month          Int
  plannedAmount  Float
  category       BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, year, month])
  @@index([categoryId, year])
}

model Cell {
  id             String             @id
  churchId       String
  name           String
  leader         String
  auxiliar       String             @default("")
  host           String             @default("")
  weekday        String
  time           String
  address        String
  neighborhood   String             @default("")
  audience       String             @default("misto")
  capacity       Int                @default(0)
  supervisor     String             @default("")
  church         Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  members        ChurchPerson[]
  attendances    CellAttendance[]

  @@index([churchId])
}

model CellAttendance {
  id             String   @id
  cellId         String
  date           String
  attendeeIds    String[] @default([])
  visitors       Int      @default(0)
  cell           Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@index([cellId, date])
}

model FinancialTransaction {
  id          String   @id
  churchId    String
  date        String
  type        String
  category    String
  description String
  amount      Float
  method      String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, date])
  @@index([churchId, category])
}

model ChurchAsset {
  id          String   @id
  churchId    String
  code        String
  name        String
  category    String
  location    String
  status      String
  value       Float
  acquiredAt  String
  responsible String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@unique([churchId, code])
  @@index([churchId, name])
}

model ChurchEvent {
  id             String   @id
  churchId       String
  title          String
  type           String
  date           String
  time           String
  location       String
  leader         String
  attendanceIds  String[] @default([])
  visitors       Int      @default(0)
  church         Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, date, time])
}

model ChurchPerson {
  id            String   @id
  churchId      String
  name          String
  phone         String
  email         String
  birthday      String
  stage         String
  group         String
  firstVisit    String
  notes         String
  contactDates  String[] @default([])
  cellId        String?
  church        Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  cell          Cell?    @relation(fields: [cellId], references: [id], onDelete: SetNull)

  @@index([churchId, stage])
  @@index([churchId, name])
  @@index([cellId])
}

model ChurchCommitment {
  id               String   @id
  churchId         String
  name             String
  category         String
  totalAmount      Float
  installments     Int
  paidInstallments Int
  nextDueDate      String
  church           Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, nextDueDate])
}
