# Banco de dados (preenchido automaticamente pela Vercel/Prisma Postgres)
DATABASE_URL=
POSTGRES_URL=
PRISMA_DATABASE_URL=

# Segredo usado para assinar o cookie de sessão (gere com: openssl rand -base64 32)
SESSION_SECRET=

# Pagamentos PIX — opcional. Deixe em branco para manter o PIX desativado
# (inscrições em cursos/eventos pagos ficam marcadas como "pendente" até
# confirmação manual). Preencha apenas UM dos dois provedores abaixo.
PIX_PROVIDER=mercadopago

# Mercado Pago (https://www.mercadopago.com.br/developers/panel)
MERCADOPAGO_ACCESS_TOKEN=

# Asaas (https://www.asaas.com/)
ASAAS_API_KEY=
ASAAS_ENV=sandbox
